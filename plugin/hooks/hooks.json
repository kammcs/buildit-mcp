{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:buildit:buildit",
            "tool": "ask",
            "input": {
              "questions": "${tool_input.questions}",
              "tool_use_id": "${tool_use_id}",
              "session_id": "${session_id}",
              "format": "hook",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}"
            },
            "timeout": 3600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:buildit:buildit",
            "tool": "turn_ended",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
