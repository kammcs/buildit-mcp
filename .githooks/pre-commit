#!/bin/sh
# Blocks commits that contain secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH; install it (winget install Gitleaks.Gitleaks) or commit from a shell that has it." >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner
