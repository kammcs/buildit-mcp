# Copy to .env next to compose.yaml. No tokens go here: each member's client
# sends its own.

# The hostname your team's clients use. Its DNS must point at this machine,
# with ports 80 and 443 open, so Caddy can get a certificate.
BUILDIT_MCP_HOST=mcp.example.com

# Toolsets the server offers (a request's X-Buildit-Toolsets header can only
# narrow them): items, comments, planning, pages, chat, admin, destructive, or all.
BUILDIT_TOOLSETS=items,comments

# true: only tools that change nothing.
BUILDIT_READ_ONLY=false

# The image tag: 0 follows 0.x releases; 0.1.0 pins one.
BUILDIT_MCP_TAG=0
